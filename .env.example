# Supabase project credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key. Server-only (src/lib/supabase/admin.ts) — never exposed
# to the client. Without it, quiz submission fails gracefully and /r/[id]
# 404s rather than crashing; see docs/decisions.md.
SUPABASE_SERVICE_ROLE_KEY=

# PostHog (EU cloud). Without a key, track() no-ops safely everywhere.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Phase 2b: the debate judge. Without a key, /api/judge always returns the
# "paused" state rather than crashing or fabricating a verdict.
ANTHROPIC_API_KEY=
# Hard ceiling lib/budget.ts checks before every judge call; see
# docs/decisions.md for how 50 was chosen. Unset or <=0 fails closed
# (judging paused), never open.
AI_MONTHLY_BUDGET_USD=50
# Set to "true" to pause judging without touching the budget/model config —
# flip this off only after reviewing 20 real verdicts, per the brief.
KILL_SWITCH_JUDGE=true
